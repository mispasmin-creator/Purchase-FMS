    'Planned', 'Actual', 'Planned2', 'Actual2', 'Planned3', 'Actual3',
    'Planned4', 'Actual4', 'Planned5', 'Actual5', 'Planned6', 'Actual6',
    'Planned8', 'Actual8',
    'Type Of Rate', 'Type Of Transporting Rate', 'Type',
    'Rate Difference', 'Quantity Difference', 'Diff Qty', 'Qty Diff Status',
