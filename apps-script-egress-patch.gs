var MAX_RUN_MS = 5 * 60 * 1000;
var _runStartedAt = 0;
var _bytesFetched = 0;
var _requestCount = 0;

function uiAlert(msg) {
  try { SpreadsheetApp.getUi().alert(msg); } catch (e) { Logger.log(msg); }
}

function checkTimeBudget() {
  if (_runStartedAt && (Date.now() - _runStartedAt) > MAX_RUN_MS) {
    throw new Error('Time budget of ' + (MAX_RUN_MS / 60000) + ' min exceeded - stopping before Apps Script kills the run. Downloaded so far: ' + (_bytesFetched / 1048576).toFixed(1) + ' MB.');
  }
}

// Same as the original, plus byte counting and the time-budget check.
function sbFetchAllRaw(table, params) {
  var url = getSupabaseUrl() + '/rest/v1/' + encodeURIComponent(table) + '?' + params.join('&');
  var pageSize = 1000;
  var start = 0;
  var total = null;
  var all = [];
  while (true) {
    checkTimeBudget();
    var res = UrlFetchApp.fetch(url, {
      method: 'get',
      headers: {
        apikey: getSupabaseKey(),
        Authorization: 'Bearer ' + getSupabaseKey(),
        Range: start + '-' + (start + pageSize - 1),
        Prefer: 'count=exact'
      },
      muteHttpExceptions: true
    });
    _requestCount++;
    var code = res.getResponseCode();
    var body = res.getContentText();
    _bytesFetched += body.length;
    if (code !== 200 && code !== 206) {
      throw new Error('Supabase error [' + code + '] for table "' + table + '": ' + body.substring(0, 300));
    }
    var batch = JSON.parse(body);
    all = all.concat(batch);

    var headers = res.getHeaders();
    var contentRange = headers['Content-Range'] || headers['content-range'];
    if (contentRange) {
      var m = String(contentRange).match(/\/(\d+|\*)$/);
      if (m && m[1] !== '*') total = parseInt(m[1], 10);
    }

    if (batch.length === 0) break;
    start += batch.length;
    if (total !== null) {
      if (start >= total) break;
    } else if (batch.length < pageSize) {
      break;
    }
  }
  return all;
}

// If a listed column does not exist in the table, PostgREST answers 400
// "column <table>.<col> does not exist". Drop that column and retry, so a
// wrong/renamed name never breaks the import (the code already treats a
// missing value as null). Anything else falls back to select=*.
function fetchProjected(table, cols, idCol) {
  var use = cols.slice();
  for (var attempt = 0; attempt < 15; attempt++) {
    try {
      return sbFetchAll(table, ['select=' + encSelect(use)], idCol);
    } catch (err) {
      var msg = String(err.message);
      if (msg.indexOf('[400]') === -1) throw err;
      var m = msg.replace(/\\"/g, '').replace(/"/g, '').match(/column (.+?) does not exist/);
      var bad = null;
      if (m) {
        use.forEach(function (c) {
          if ((m[1] === c || m[1] === table + '.' + c) && (!bad || c.length > bad.length)) bad = c;
        });
      }
      if (!bad) {
        Logger.log('[projection] ' + table + ': unrecognised 400, falling back to select=*: ' + msg.substring(0, 200));
        return sbFetchAll(table, ['select=*'], idCol);
      }
      Logger.log('[projection] ' + table + ': column "' + bad + '" does not exist, dropped.');
      use = use.filter(function (c) { return c !== bad; });
    }
  }
  return sbFetchAll(table, ['select=*'], idCol);
}

function getFullTable(table, idCol) {
  if (!_tableCache[table]) {
    var cols = TABLE_COLUMNS[table];
    _tableCache[table] = cols ? fetchProjected(table, cols, idCol) : sbFetchAll(table, ['select=*'], idCol);
  }
  return _tableCache[table];
}

function importAllSteps() {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) {
    uiAlert('Another import is already running - skipped this run.');
    return;
  }
  var ss = SpreadsheetApp.getActiveSpreadsheet();

  _tableCache = {};
  _runStartedAt = Date.now();
  _bytesFetched = 0;
  _requestCount = 0;
  var summary = [];
  try {
    SIMPLE_STEPS.forEach(function (cfg) { summary.push(importSimpleStep(ss, cfg)); });
    summary.push(importMgmtApp(ss));
    summary.push(importPoEntry(ss));
    summary.push(importAdvancePayment(ss));
    summary.push(importPoHistory(ss));
    summary.push(importArrangeLogistics(ss));
    summary.push(importLogisticsApproval(ss));
    summary.push(importLab(ss));
    summary.push(importBilty(ss));
    summary.push(importReceipt(ss));
    summary.push(importLift(ss));
    summary.push(importLiftDelayReport(ss));
    summary.push(importUnloadApproval(ss));
    summary.push(importLabReport(ss));
    summary.push(importCrm(ss));
    summary.push(importMismatchStep(ss));
    summary.push(importPurchaserCoordinate(ss));
    summary.push(importDebitNote(ss));
    summary.push(importFullkitting(ss));
    summary.push(importAccountsAudit(ss));
    summary.push(importAccountsAuditLive(ss));
    summary.push(importSaleOfRawMaterial(ss));
    summary.push(importPurchaseReturn(ss));
    summary.push(importKyc(ss));
    summary.push(importTolerance(ss));
    summary.push(importVendorPayment(ss));
    summary.push(importFinalTallyEntry(ss));
    summary.push(importRectifyMistake2(ss));

    writeSummarySheet(ss, summary);
    var mb = (_bytesFetched / 1048576).toFixed(1);
    Logger.log('Egress this run: ' + mb + ' MB in ' + _requestCount + ' requests');
    uiAlert('Import complete: ' + summary.length + ' steps refreshed. See "Summary" sheet.\nDownloaded from Supabase: ' + mb + ' MB (' + _requestCount + ' requests).');
  } catch (err) {
    uiAlert('Import failed: ' + err.message);
    throw err;
  } finally {
    lock.releaseLock();
  }
}

function installSixHourlyTrigger() {
  removeHourlyTrigger();
  ScriptApp.newTrigger('importAllSteps').timeBased().everyHours(6).create();
  uiAlert('Auto-refresh installed - the sheet will pull live data every 6 hours.');
}
